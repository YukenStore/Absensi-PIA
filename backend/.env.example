# =========================================================
# KONFIGURASI DATABASE SQL (SUPABASE POSTGRESQL / SQLITE)
# =========================================================
# Untuk Supabase, gunakan URI Connection String dari Dashboard Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Jika dikosongkan, sistem otomatis menggunakan SQL lokal (sqlite:///./absensi_pia.db)
DATABASE_URL=sqlite:///./absensi_pia.db

# =========================================================
# KONFIGURASI KEAMANAN JWT
# =========================================================
JWT_SECRET_KEY=ganti_dengan_secret_key_acak_yang_panjang_dan_aman
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =========================================================
# KONFIGURASI SMTP GMAIL UNTUK PENGIRIMAN KODE OTP EMAIL
# =========================================================
# Gunakan App Password Google (16 karakter) pada SMTP_PASSWORD
# Jika dikosongkan, kode OTP otomatis dicetak di terminal backend saat testing lokal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Sistem Absensi PIA
