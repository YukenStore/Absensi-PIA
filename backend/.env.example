# =========================================================
# KONFIGURASI DATABASE SQL CLOUDFLARE D1 & FALLBACK LOKAL
# =========================================================
# Isi ketiga variabel di bawah ini untuk terhubung langsung ke Cloudflare D1 SQL API:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Lokasi file SQLite lokal apabila Cloudflare D1 belum diisi (sintaks SQL 100% kompatibel dengan D1):
LOCAL_SQLITE_PATH=absensi_pia.db

# =========================================================
# KONFIGURASI KEAMANAN JWT
# =========================================================
JWT_SECRET_KEY=ganti_dengan_secret_key_acak_yang_panjang_dan_aman
JWT_EXPIRE_MINUTES=1440

# =========================================================
# KONFIGURASI SMTP GMAIL UNTUK PENGIRIMAN KODE OTP EMAIL
# =========================================================
# Gunakan App Password Google (16 karakter) pada SMTP_PASSWORD
# Jika dikosongkan, kode OTP otomatis dicetak di terminal backend saat testing lokal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Sistem Absensi PIA
